---
// One plain icon button (no border or circle). The first visit opens in light (ThemeProvider.astro);
// a click switches light/dark and is remembered. Uses Starlight's storage key so its inline
// ThemeProvider sets the theme before paint (no flash). Icons: Lucide sun/moon (ISC), see LICENSES/lucide.txt.
import { lucide } from '../../icons/lucide';
---

<klinos-theme-toggle>
	<button class="themebtn" type="button" aria-label="Switch theme">
		<Fragment set:html={lucide('sun', 'k-icon i-sun')} />
		<Fragment set:html={lucide('moon', 'k-icon i-moon')} />
		<span class="tt" aria-hidden="true">Switch theme</span>
	</button>
</klinos-theme-toggle>

<script>
	const KEY = 'starlight-theme';
	const root = document.documentElement;

	const current = () => (root.dataset.theme === 'dark' ? 'dark' : 'light');

	function sync() {
		const next = current() === 'dark' ? 'light' : 'dark';
		document.querySelectorAll('klinos-theme-toggle button').forEach((b) => {
			b.setAttribute('aria-label', `Switch to ${next} theme`);
			const tt = b.querySelector('.tt');
			if (tt) tt.textContent = `Switch to ${next}`;
		});
	}

	function apply(theme: 'light' | 'dark') {
		root.dataset.theme = theme;
		sync();
		window.dispatchEvent(new CustomEvent('klinos:theme', { detail: theme }));
	}

	class KlinosThemeToggle extends HTMLElement {
		connectedCallback() {
			sync();
			this.querySelector('button')?.addEventListener('click', () => {
				const next = current() === 'dark' ? 'light' : 'dark';
				try {
					localStorage.setItem(KEY, next);
				} catch {}
				apply(next);
			});
		}
	}
	customElements.define('klinos-theme-toggle', KlinosThemeToggle);
</script>
