---
// Header. Desktop (981px and up): the logo and "Klinos Docs" on the left; the section dropdown ("Guide" or
// "Develop", components/SectionMenu.astro), What's new, Try it live and the theme toggle on the right. Search is a
// field at the top of the sidebar there (overrides/Sidebar.astro); the search component stays here, out of the
// layout, because it owns the one dialog and the Ctrl/Cmd+K shortcut.
// Tablet and phone: the title on the left; the Try it live icon, the search icon and the menu button on the right.
// The version is not in the header: Home links it to the changelog (KLINOS_VERSION in src/config.ts).
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import WhatsNew from '../WhatsNew.astro';
import SectionMenu from '../SectionMenu.astro';
// Lucide icon (ISC), copied from lucide-static 1.49.0; see LICENSES/lucide.txt.
import rotate3d from '../../icons/lucide/rotate-3d.svg?raw';
import { lucide } from '../../icons/lucide';

const brandMark = rotate3d.replace(/<!--[\s\S]*?-->\s*/, '').replace('<svg', '<svg aria-hidden="true" focusable="false"').replace('class="lucide lucide-rotate-3d"', 'class="brand-mark lucide lucide-rotate-3d"');

const LIVE = '/using-klinos/reference/try-it-live/';
const onLive = Astro.url.pathname === LIVE;
// One icon set in the header: Lucide at stroke 2, sized by CSS (--k-icon).
const tryIcon = lucide('square-play', 'k-icon');
---

<div class="header k-header">
	<div class="title-wrapper sl-flex">
		<a class="brand" href="/using-klinos/start-here/home/" aria-label="Klinos Docs, home">
			<Fragment set:html={brandMark} />
			<span translate="no">Klinos <small>Docs</small></span>
		</a>
	</div>
	<div class="sl-flex print:hidden k-search">
		<a class="k-try-icon" href={LIVE} aria-label="Try it live" aria-current={onLive ? 'page' : undefined} set:html={tryIcon} />
		<Search />
	</div>
	<div class="k-desktop-only print:hidden right-group">
		<SectionMenu place="header" />
		<button class="k-whatsnew" type="button" data-wn-open>What's new</button>
		<a class="k-try" href={LIVE} aria-current={onLive ? 'page' : undefined}><Fragment set:html={tryIcon} />Try it live</a>
		<ThemeSelect />
	</div>
</div>
<WhatsNew />

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}
		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}
		.right-group {
			gap: var(--k-header-gap, 16px);
			align-items: center;
		}
		@media (min-width: 981px) {
			.header {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				align-items: center;
			}
			.title-wrapper {
				justify-self: start;
			}
			/* The search component: no trigger here on desktop (the sidebar field opens it), and out of the grid. It
			   stays rendered (not display: none), so its dialog can open. */
			.k-search {
				position: absolute;
				width: 0;
				height: 0;
				overflow: visible;
			}
		}
	}
</style>
