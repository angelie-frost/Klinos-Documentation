---
// Header: logo + "Klinos Docs", search, Try it live, version badge, theme toggle.
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { KLINOS_VERSION } from '../../config';

const LIVE = '/using-klinos/reference/try-it-live/';
const onLive = Astro.url.pathname === LIVE;
const tryIcon =
	'<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="1.8" y="2.8" width="12.4" height="10.4" rx="2"/><path d="M6.6 6v4l3.4-2z" fill="currentColor" stroke="none"/></svg>';
---

<div class="header k-header">
	<div class="title-wrapper sl-flex">
		<a class="brand" href="/" aria-label="Klinos Docs, home">
			<svg class="brand-mark" viewBox="0 0 22 22" aria-hidden="true"
				><rect x="5.5" y="1.5" width="11" height="19" rx="3" fill="none" stroke="currentColor" stroke-width="1.5"
				></rect><rect x="7.5" y="4" width="7" height="14" rx="1.5" fill="currentColor" opacity=".18"></rect></svg
			>
			<span translate="no">Klinos <small>Docs</small></span>
		</a>
	</div>
	<div class="sl-flex print:hidden k-search">
		<a class="k-try-icon" href={LIVE} aria-label="Try it live" aria-current={onLive ? 'page' : undefined} set:html={tryIcon} />
		<Search />
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<a class="k-try" href={LIVE} aria-current={onLive ? 'page' : undefined}><Fragment set:html={tryIcon} />Try it live</a>
		<span class="k-badge" title="Packaged build">v{KLINOS_VERSION}</span>
		<ThemeSelect />
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}
		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}
		.right-group {
			gap: 12px;
			align-items: center;
		}
		@media (min-width: 50rem) {
			.header {
				display: grid;
				grid-template-columns: calc(var(--sl-sidebar-width) - var(--sl-nav-pad-x)) 1fr auto;
				align-content: center;
			}
			.k-search {
				justify-content: center;
			}
		}
	}
</style>
