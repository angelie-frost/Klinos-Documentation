---
// The section dropdown, like Mintlify's "Learn" menu: a trigger showing the current section ("Guide" or "Develop")
// and a panel with both sections, each a real link to its first page with a one-line description
// (SECTION_DESCRIPTIONS in src/lib/sections.ts). A disclosure (a button with aria-expanded and aria-controls, then
// links), not role="menu". Click only, no hover-open.
// "header": in the header's right group from 981px, the panel floating under the trigger, right-aligned.
// "menu": at the top of the tablet/phone menu (980px and below), the panel expanding inline.
// Icon: Lucide chevron-down (ISC), see LICENSES/lucide.txt.
import { sectionItems } from '../lib/sections';
import { lucide } from '../icons/lucide';

interface Props {
	place: 'header' | 'menu';
}
const { place } = Astro.props;
const items = sectionItems(Astro.locals.starlightRoute.sidebar);
const current = items.find((i) => i.current) ?? items[0];
const id = `k-secmenu-${place}`;
const chevron = lucide('chevron-down', 'k-icon k-secmenu-chev');
---

<k-section-menu class:list={['k-secmenu', `k-secmenu-${place}`, place === 'header' ? 'k-desktop-only' : 'k-touch-only']} data-place={place}>
	<button class="k-secmenu-trigger" type="button" aria-expanded="false" aria-controls={id}>
		<span>{current?.label}</span>
		<Fragment set:html={chevron} />
	</button>
	<div class="k-secmenu-panel" id={id} hidden>
		{
			items.map((i) => (
				<a class="k-secmenu-item" href={i.href} aria-current={i.current ? 'true' : undefined}>
					<span class="k-secmenu-title">{i.label}</span>
					{i.description && <span class="k-secmenu-desc">{i.description}</span>}
				</a>
			))
		}
	</div>
</k-section-menu>

<script>
	class KSectionMenu extends HTMLElement {
		connectedCallback() {
			const trigger = this.querySelector<HTMLButtonElement>('.k-secmenu-trigger')!;
			const panel = this.querySelector<HTMLElement>('.k-secmenu-panel')!;
			const items = [...panel.querySelectorAll<HTMLAnchorElement>('.k-secmenu-item')];
			const isOpen = () => !panel.hidden;
			const setOpen = (open: boolean, focusTrigger = false) => {
				panel.hidden = !open;
				trigger.setAttribute('aria-expanded', String(open));
				if (!open && focusTrigger) trigger.focus();
			};
			const focusItem = (i: number) => items[(i + items.length) % items.length]?.focus();

			trigger.addEventListener('click', () => setOpen(!isOpen()));
			trigger.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowDown') {
					e.preventDefault();
					setOpen(true);
					focusItem(0);
				}
			});
			panel.addEventListener('keydown', (e) => {
				const at = items.indexOf(document.activeElement as HTMLAnchorElement);
				if (e.key === 'ArrowDown') focusItem(at + 1);
				else if (e.key === 'ArrowUp') focusItem(at - 1);
				else if (e.key === 'Home') focusItem(0);
				else if (e.key === 'End') focusItem(items.length - 1);
				else return;
				e.preventDefault();
			});
			this.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && isOpen()) {
					e.preventDefault();
					setOpen(false, true);
				}
			});
			// A click outside closes it; so does focus leaving the control.
			document.addEventListener('click', (e) => {
				if (isOpen() && !this.contains(e.target as Node)) setOpen(false);
			});
			this.addEventListener('focusout', (e) => {
				if (isOpen() && !this.contains(e.relatedTarget as Node | null)) setOpen(false);
			});
			// Choosing an item closes it at once; leaving the page closes it before the old page is captured for the
			// view transition (capture phase, so this runs first), and a page restored from the back/forward cache
			// starts closed.
			items.forEach((a) => a.addEventListener('click', () => setOpen(false)));
			addEventListener('pageswap', () => setOpen(false), { capture: true });
			addEventListener('pageshow', (e) => {
				if ((e as PageTransitionEvent).persisted) setOpen(false);
			});
		}
	}
	customElements.define('k-section-menu', KSectionMenu);
</script>
