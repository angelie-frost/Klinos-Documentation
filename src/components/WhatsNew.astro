---
// "What's new in V3": a small, non-blocking card for first-time visitors (Home only), reopened from the header.
// The slides follow the plugin's own first-run tour: the same order, titles and text as WN_SLIDES in the plugin's
// src/ui.html (v3.16 and main). When WN_SLIDES changes in the plugin, update this list to match.
// Visuals are media already captured from the panel (public/media/); "Read more" links to the docs page.
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

const ROOT = process.cwd();

const SLIDES = [
	{
		label: 'Built on real 3D models',
		text: "V2 drew each device with a raymarching shader. V3 builds them as 3D models in Three.js and keeps V2's calibrated finishes, so devices still match V2. The models add what the old renderer lacked: a mirror floor reflection, raised camera lenses, podiums and smoother edges.",
		href: '/using-klinos/studio/devices/',
		// The floor reflection, one of the things the models added.
		media: 'using-klinos/studio/backdrop-shadow/2',
	},
	{
		label: 'Editable lighting',
		text: 'Looks, plus an editor for the softbox lights. Calibrated is the default and matches V2.',
		href: '/using-klinos/studio/lighting/',
		media: 'using-klinos/studio/lighting/2',
	},
	{
		label: 'Staging and positioning',
		text: 'In Studio, the Staging card sets up a ready-made scene, such as Floating, Podium or Spotlight. Every value stays editable, and Revert puts back what the scene changed, until you edit one of those values. Turn on Position in the Frame card, then drag the device in the preview to move it.',
		href: '/using-klinos/studio/staging/',
		media: 'using-klinos/studio/staging/4',
	},
	{
		label: 'A sharper preview',
		text: "It renders at your screen's pixel density and stays sharp when you zoom. In Studio, drag the preview to turn the device and check your mockup.",
		// The preview has no docs page of its own; the live demo is where to try it.
		href: '/using-klinos/reference/try-it-live/',
		media: 'whatsnew/preview',
	},
	{
		label: 'Polished frame and Surface texture',
		text: 'A mirror-polished frame for the phones, and a fine grain that makes the body read as metal. Both start off.',
		href: '/using-klinos/studio/devices/#polished-frame-phones-only',
		media: 'whatsnew/finish',
	},
	{
		label: 'Photoreal mode',
		text: 'Static renders of real devices, the iPhone 17 Pro and the MacBook Pro 14 inch, with your design in the screen.',
		href: '/using-klinos/photoreal/photoreal/',
		media: 'using-klinos/photoreal/photoreal/2',
	},
	{
		label: 'Playground mode',
		text: 'Any Figma layer as an angled card, or several layers as a layout.',
		href: '/using-klinos/playground/layouts/',
		media: 'using-klinos/playground/layouts/2',
	},
	{
		label: 'Arrange the panel',
		text: 'Drag a card by the grip at its top right to move it, or open the grip for Move up, Move down and Reset order. Each mode keeps its own order, and Klinos remembers it.',
		href: '/using-klinos/panel/panel-cards/',
		// The grip menu.
		media: 'using-klinos/panel/panel-cards/2',
	},
	{
		label: 'Dark theme',
		text: 'The panel now has a dark version, and follows Figma by default. Change it with the switch at the top left.',
		href: '/using-klinos/start-here/about-klinos/#what-v3-added',
		// The panel's own dark theme: always the dark capture of the panel.
		media: 'using-klinos/reference/try-it-live/1',
		only: 'dark',
	},
];

function media(id, only) {
	const [slug, n] = [id.slice(0, id.lastIndexOf('/')), id.slice(id.lastIndexOf('/') + 1)];
	const meta = join(ROOT, 'public', 'media', slug, `${n}.json`);
	if (!existsSync(meta)) return null;
	const m = JSON.parse(readFileSync(meta, 'utf8'));
	const url = (v) => `/media/${slug}/${v.src}`;
	const dark = url(m.dark ?? m.light);
	return { w: m.w, h: m.h, light: only === 'dark' ? dark : url(m.light), dark };
}

const slides = SLIDES.map((s) => {
	const img = media(s.media, s.only);
	if (!img) throw new Error(`What's new: no captured media "${s.media}" for "${s.label}"`);
	return { ...s, img };
});
---

<section class="whatsnew" id="whatsnew" role="dialog" aria-modal="false" aria-labelledby="whatsnew-title" hidden data-pagefind-ignore>
	<div class="wn-head">
		<h2 id="whatsnew-title" tabindex="-1">What's new in V3</h2>
		<button class="wn-close" type="button" aria-label="Close What's new" data-wn-close>&times;</button>
	</div>
	<ol class="wn-slides" aria-live="polite">
		{
			slides.map((s, i) => (
				<li class="wn-slide" data-wn-slide hidden={i > 0} aria-label={`${i + 1} of ${slides.length}: ${s.label}`}>
					{s.img && (
						<a class="wn-art" href={s.href} tabindex="-1" aria-hidden="true">
							{s.img.light === s.img.dark ? (
								<img src={s.img.light} width={s.img.w} height={s.img.h} alt="" loading="lazy" decoding="async" />
							) : (
								<>
									<img class="media-light" src={s.img.light} width={s.img.w} height={s.img.h} alt="" loading="lazy" decoding="async" />
									<img class="media-dark" src={s.img.dark} width={s.img.w} height={s.img.h} alt="" loading="lazy" decoding="async" />
								</>
							)}
						</a>
					)}
					<p class="wn-slide-title">{s.label}</p>
					<p class="wn-text">{s.text}</p>
					<a class="wn-more" href={s.href}>Read more<span class="sr-only"> about {s.label}</span></a>
				</li>
			))
		}
	</ol>
	<div class="wn-foot">
		<label class="wn-never"><input type="checkbox" data-wn-never /> Don't show again</label>
		<div class="wn-nav">
			<button type="button" class="wn-btn" data-wn-prev disabled>Back</button>
			<span class="wn-count" data-wn-count>1 of {slides.length}</span>
			<button type="button" class="wn-btn wn-primary" data-wn-next>Next</button>
		</div>
	</div>
</section>

<script>
	const KEY = 'klinos-whatsnew-v3'; // change the key to show the card again for a future release
	const HOME = '/using-klinos/start-here/home/';
	const card = document.getElementById('whatsnew') as HTMLElement | null;

	const read = (): string | null => {
		try {
			return localStorage.getItem(KEY);
		} catch {
			return null;
		}
	};
	const write = (v: string) => {
		try {
			localStorage.setItem(KEY, v);
		} catch {
			/* storage blocked: the card still works for this page view */
		}
	};

	if (card) {
		const slides = [...card.querySelectorAll<HTMLElement>('[data-wn-slide]')];
		const prev = card.querySelector<HTMLButtonElement>('[data-wn-prev]')!;
		const next = card.querySelector<HTMLButtonElement>('[data-wn-next]')!;
		const count = card.querySelector<HTMLElement>('[data-wn-count]')!;
		const never = card.querySelector<HTMLInputElement>('[data-wn-never]')!;
		const title = card.querySelector<HTMLElement>('#whatsnew-title')!;
		const openers = () => document.querySelectorAll<HTMLElement>('[data-wn-open]');
		let index = 0;
		let returnTo: HTMLElement | null = null;

		const show = (i: number) => {
			index = Math.max(0, Math.min(slides.length - 1, i));
			slides.forEach((s, k) => (s.hidden = k !== index));
			prev.disabled = index === 0;
			const last = index === slides.length - 1;
			next.textContent = last ? 'Done' : 'Next';
			count.textContent = `${index + 1} of ${slides.length}`;
		};
		const open = (from: HTMLElement | null) => {
			returnTo = from ?? (document.activeElement as HTMLElement | null);
			show(0);
			never.checked = read() === 'dismissed';
			card.hidden = false;
			title.focus();
		};
		const close = () => {
			if (card.hidden) return;
			card.hidden = true;
			if (never.checked) {
				write('dismissed');
				openers().forEach((b) => (b.hidden = true));
			} else if (read() !== 'dismissed') {
				write('seen');
			}
			// Focus goes back to where it was (the header button, or the page if it opened by itself).
			if (returnTo && document.contains(returnTo) && returnTo !== document.body) returnTo.focus();
			returnTo = null;
		};

		prev.addEventListener('click', () => show(index - 1));
		next.addEventListener('click', () => (index === slides.length - 1 ? close() : show(index + 1)));
		card.querySelector('[data-wn-close]')!.addEventListener('click', close);
		// Esc closes it wherever focus is (the card does not trap focus, since it never blocks the page).
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !card.hidden && !document.querySelector('dialog[open]')) close();
		});
		openers().forEach((b) => {
			b.hidden = read() === 'dismissed';
			b.addEventListener('click', () => {
				// From the phone menu: close the menu first, or the card would sit behind it.
				const menu = document.getElementById('starlight__sidebar');
				if (b.closest('#starlight__sidebar') && menu?.matches(':popover-open')) {
					menu.hidePopover();
					open(document.querySelector<HTMLElement>('button.sl-menu-button'));
					return;
				}
				card.hidden ? open(b) : close();
			});
		});

		// First visit only, Home only, and only when the visitor landed on Home directly:
		// no hash or query (deep link or search landing) and not arriving from another page of this site.
		const onHome = location.pathname === HOME;
		const direct = !location.hash && !location.search;
		let fromSite = false;
		try {
			const ref = document.referrer ? new URL(document.referrer) : null;
			// The bare site root redirects to Home, so arriving from "/" still counts as landing on Home directly.
			fromSite = !!ref && ref.origin === location.origin && ref.pathname !== '/';
		} catch {}
		if (onHome && direct && !fromSite && read() === null) {
			write('seen');
			open(null);
		}
	}
</script>
