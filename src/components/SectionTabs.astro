---
// "User guide / Team handbook": a segmented control, one option per top-level section of sidebar.md (the ## names).
// The sidebar shows only the current section's groups (overrides/Sidebar.astro); these options switch between them.
// Each option links to its section's first page. In the sidebar's pinned block under the search field from 981px
// ("sidebar"), and at the top of the menu below that ("menu").
import { sectionTabs } from '../lib/sections';

interface Props {
	place: 'sidebar' | 'menu';
}
const { place } = Astro.props;
const tabs = sectionTabs(Astro.locals.starlightRoute.sidebar);
---

<nav class:list={['k-tabs', `k-tabs-${place}`, place === 'sidebar' ? 'k-desktop-only' : 'k-touch-only']} aria-label="Docs sections">
	{
		tabs.map((t) => (
			<a class="k-tab" href={t.href} aria-current={t.current ? 'true' : undefined}>
				{t.label}
			</a>
		))
	}
</nav>
